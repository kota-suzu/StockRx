# ================================================================================
# Production Environment Variables for StockRx
# Copy this file to .env.production and fill in the actual values
# ================================================================================

# Rails Configuration
RAILS_ENV=production
RAILS_MASTER_KEY=your_rails_master_key_here
SECRET_KEY_BASE=your_secret_key_base_here
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5

# Application Settings
PORT=3000
WEB_CONCURRENCY=2
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# Database Configuration
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USERNAME=stockrx
DATABASE_PASSWORD=strong_password_here
DATABASE_ROOT_PASSWORD=root_password_here
DATABASE_POOL=25
DATABASE_TIMEOUT=5000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here
REDIS_URL=redis://:redis_password_here@redis:6379/0
CABLE_REDIS_URL=redis://:redis_password_here@redis:6379/1

# Email Configuration
MAIL_DELIVERY_METHOD=smtp
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_DOMAIN=yourdomain.com
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
MAIL_FROM=noreply@yourdomain.com

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret

# Security Settings
FORCE_SSL=true
SSL_REDIRECT=true
SECURE_HEADERS=true

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=strict

# Asset Configuration
ASSETS_HOST=https://assets.yourdomain.com
ASSETS_PRECOMPILE=true
ASSETS_COMPRESS=true

# Monitoring and APM
NEW_RELIC_LICENSE_KEY=your_new_relic_key_here
NEW_RELIC_APP_NAME=StockRx Production
SENTRY_DSN=https://your_sentry_dsn_here
DATADOG_API_KEY=your_datadog_api_key_here

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=stockrx-backups
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Feature Flags
ENABLE_GITHUB_AUTH=true
ENABLE_EMAIL_AUTH=true
ENABLE_2FA=true
ENABLE_API_RATE_LIMITING=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CDN Configuration (Optional)
CDN_HOST=https://cdn.yourdomain.com
CDN_ENABLED=true

# Deployment Configuration
DEPLOY_USER=deploy
DEPLOY_HOST=your.production.server.com
DEPLOY_PATH=/var/www/stockrx

# Health Check
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=90

# Performance
ENABLE_RACK_CACHE=true
ENABLE_RACK_DEFLATER=true
ENABLE_BOOTSNAP=true
JEMALLOC_ENABLED=true