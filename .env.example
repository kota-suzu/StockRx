MYSQL_ROOT_PASSWORD=yourpassword
MYSQL_DATABASE=app_db
RAILS_ENV=development
TZ=Asia/Tokyo

# GitHub OAuth設定
# GitHub Developer Settings > OAuth Apps から取得
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Devise設定（オプション）
# 未設定の場合は自動生成されます
# DEVISE_SECRET_KEY=your_devise_secret_key_minimum_64_characters

# ============================================
# Performance & Cache Configuration
# ============================================
# Bootsnap Configuration (DevOps/SRE: 権限問題対策)
# development環境では無効化推奨（デバッグ容易性向上）
DISABLE_BOOTSNAP=true

# Rails Configuration
RAILS_MAX_THREADS=5
