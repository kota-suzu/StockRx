<!DOCTYPE html>
<html>
  <head>
    <title>StockRx - 管理者パネル</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%# ログアウトボタンの視認性向上のためのカスタムCSS %>
    <style>
      /* ユーザーメニューの強調 */
      #userDropdown {
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 0.375rem;
        padding: 0.375rem 0.75rem;
        transition: all 0.3s ease;
      }
      
      #userDropdown:hover,
      #userDropdown:focus,
      #userDropdown[aria-expanded="true"] {
        background-color: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.4);
      }
      
      /* ログアウトボタンの強調 */
      .logout-btn {
        transition: all 0.3s ease;
        border-top: 1px solid #dee2e6;
        margin-top: 0.5rem;
        padding-top: 0.75rem !important;
        padding-bottom: 0.75rem !important;
      }
      
      .logout-btn:hover {
        background-color: #dc3545 !important;
        color: white !important;
        transform: translateX(5px);
      }
      
      .logout-btn:hover i {
        animation: slide-out 0.3s ease-in-out;
      }
      
      @keyframes slide-out {
        0% { transform: translateX(0); }
        50% { transform: translateX(3px); }
        100% { transform: translateX(0); }
      }
      
      /* モバイルビューでの改善 */
      @media (max-width: 767px) {
        #userDropdown {
          padding: 0.5rem 1rem;
          font-size: 1.1rem;
        }
        
        .dropdown-menu {
          min-width: 200px;
        }
      }
      
      /* ドロップダウンメニューの改善 */
      .dropdown-menu-end {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(0, 0, 0, 0.1);
      }
      
      /* TODO: 🟢 Phase 4（推奨）- ダークモード対応 */
      /* 優先度: 低（ユーザビリティ向上） */
      /* 実装内容: システム設定に応じたダークモード切替 */
      /* メタ認知: 現代のUIトレンドに対応 */
    </style>
  </head>

  <body class="admin-layout">
    <% if admin_signed_in? %>
      <!-- ライトテーマ対応管理者ナビゲーション -->
      <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top shadow-sm">
        <div class="container-fluid">
          <%= link_to admin_root_path, class: "navbar-brand d-flex align-items-center", style: "color: var(--text-accent); text-decoration: none;" do %>
            <i class="bi bi-boxes me-2" style="color: var(--text-accent);"></i>
            <span class="fw-bold" style="color: var(--text-primary);">StockRx</span>
            <small class="badge ms-2" style="background-color: var(--text-accent); color: var(--text-light);">管理パネル</small>
          <% end %>
          
          <%# Bootstrap 5 Offcanvasを使用したモバイルメニュー %>
          <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminOffcanvas" 
                  aria-controls="adminOffcanvas" aria-label="メニューを開く">
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
              <!-- ダッシュボード -->
              <li class="nav-item">
                <%= link_to admin_root_path, 
                    class: "nav-link d-flex align-items-center #{'active' if current_page?(admin_root_path)}", 
                    style: "color: var(--text-secondary) !important; font-weight: 500; transition: var(--transition-fast);",
                    onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                    onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';",
                    title: "ダッシュボード" do %>
                  <i class="bi bi-speedometer2 me-2" style="color: var(--text-accent);"></i>
                  <span class="d-none d-lg-inline">ダッシュボード</span>
                  <span class="d-lg-none">ダッシュボード</span>
                <% end %>
              </li>

              <!-- マルチストア管理メニュー（権限による表示制御） -->
              <% if current_admin.can_access_all_stores? || current_admin.store_manager? %>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle d-flex align-items-center <%= 'active' if request.path.include?('/admin/stores') %>" 
                     href="#" id="storeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                     style="color: var(--text-secondary) !important; font-weight: 500; transition: var(--transition-fast);"
                     onmouseover="this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';"
                     onmouseout="this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';"
                     title="店舗管理">
                    <i class="bi bi-shop me-2" style="color: var(--text-accent);"></i>
                    <span class="d-none d-lg-inline">店舗管理</span>
                    <span class="d-lg-none">店舗</span>
                  </a>
                  <ul class="dropdown-menu border-0 shadow" style="border-radius: var(--radius-lg); background-color: var(--bg-primary);">
                    <li>
                      <%= link_to admin_stores_path, class: "dropdown-item d-flex align-items-center", 
                          style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                          onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                          onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                        <i class="bi bi-list me-2" style="color: var(--text-accent);"></i>
                        <span style="color: var(--text-primary);">店舗一覧</span>
                      <% end %>
                    </li>
                    <% if current_admin.headquarters_admin? %>
                      <li>
                        <%= link_to new_admin_store_path, class: "dropdown-item d-flex align-items-center",
                            style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                            onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                            onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                          <i class="bi bi-plus-circle me-2" style="color: var(--text-success);"></i>
                          <span style="color: var(--text-primary);">新規店舗</span>
                        <% end %>
                      </li>
                      <li><hr class="dropdown-divider" style="border-color: var(--border-primary);"></li>
                      <li>
                        <%= link_to admin_stores_path, class: "dropdown-item d-flex align-items-center",
                            style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                            onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                            onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                          <i class="bi bi-graph-up me-2" style="color: var(--text-info);"></i>
                          <span style="color: var(--text-primary);">店舗分析</span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </li>

                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle d-flex align-items-center <%= 'active' if request.path.include?('/admin/transfers') %>" 
                     href="#" id="transferDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                     style="color: var(--text-secondary) !important; font-weight: 500; transition: var(--transition-fast);"
                     onmouseover="this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';"
                     onmouseout="this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';"
                     title="店舗間移動">
                    <i class="bi bi-truck me-2" style="color: var(--text-accent);"></i>
                    <span class="d-none d-lg-inline">移動管理</span>
                    <span class="d-lg-none">移動</span>
                  </a>
                  <ul class="dropdown-menu border-0 shadow" style="border-radius: var(--radius-lg); background-color: var(--bg-primary);">
                    <li>
                      <%= link_to admin_inter_store_transfers_path, class: "dropdown-item d-flex align-items-center",
                          style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                          onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                          onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                        <i class="bi bi-list me-2" style="color: var(--text-accent);"></i>
                        <span style="color: var(--text-primary);">移動一覧</span>
                      <% end %>
                    </li>
                    <li>
                      <%= link_to new_admin_inter_store_transfer_path, class: "dropdown-item d-flex align-items-center",
                          style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                          onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                          onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                        <i class="bi bi-plus-circle me-2" style="color: var(--text-success);"></i>
                        <span style="color: var(--text-primary);">新規申請</span>
                      <% end %>
                    </li>
                    <% if current_admin.can_approve_transfers? %>
                      <li><hr class="dropdown-divider" style="border-color: var(--border-primary);"></li>
                      <li>
                        <%= link_to pending_admin_inter_store_transfers_path, class: "dropdown-item position-relative d-flex align-items-center",
                            style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                            onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                            onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                          <i class="bi bi-clock me-2" style="color: var(--text-warning);"></i>
                          <span style="color: var(--text-primary);">承認待ち</span>
                          <% begin %>
                            <% pending_count = current_admin&.accessible_store_ids&.any? ? InterStoreTransfer.accessible_to_admin(current_admin).pending.count : 0 %>
                            <% if pending_count > 0 %>
                              <span class="badge position-absolute top-0 start-100 translate-middle" 
                                    style="background-color: var(--text-warning); color: var(--text-light);">
                                <%= pending_count %>
                              </span>
                            <% end %>
                          <% rescue => e %>
                            <%# エラーログ記録（本番環境での障害調査用） %>
                            <% Rails.logger.error "承認待ち件数取得エラー: #{e.message}" if Rails.env.production? %>
                            <%# 開発環境では警告表示、本番環境では静かに失敗 %>
                            <% unless Rails.env.production? %>
                              <span class="badge" style="background-color: var(--text-danger);">!</span>
                            <% end %>
                          <% end %>
                        <% end %>
                      </li>
                    <% end %>
                    <% if current_admin.headquarters_admin? %>
                      <li>
                        <%= link_to analytics_admin_inter_store_transfers_path, class: "dropdown-item d-flex align-items-center",
                            style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                            onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                            onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                          <i class="bi bi-graph-up me-2" style="color: var(--text-info);"></i>
                          <span style="color: var(--text-primary);">分析ダッシュボード</span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </li>
              <% end %>

              <!-- 在庫管理 -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center <%= 'active' if request.path.include?('/admin/inventories') %>" 
                   href="#" id="inventoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                   style="color: var(--text-secondary) !important; font-weight: 500; transition: var(--transition-fast);"
                   onmouseover="this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';"
                   onmouseout="this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';"
                   title="在庫管理">
                  <i class="bi bi-boxes me-2" style="color: var(--text-accent);"></i>
                  <span class="d-none d-lg-inline">在庫管理</span>
                  <span class="d-lg-none">在庫</span>
                </a>
                <ul class="dropdown-menu border-0 shadow" style="border-radius: var(--radius-lg); background-color: var(--bg-primary);">
                  <li>
                    <%= link_to admin_inventories_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-list me-2" style="color: var(--text-accent);"></i>
                      <span style="color: var(--text-primary);">商品一覧</span>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to new_admin_inventory_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-plus-circle me-2" style="color: var(--text-success);"></i>
                      <span style="color: var(--text-primary);">新規登録</span>
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider" style="border-color: var(--border-primary);"></li>
                  <li>
                    <%= link_to admin_inventories_path(filter: "low_stock"), class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-exclamation-triangle me-2" style="color: var(--text-warning);"></i>
                      <span style="color: var(--text-primary);">低在庫アラート</span>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to import_form_admin_inventories_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-upload me-2" style="color: var(--text-info);"></i>
                      <span style="color: var(--text-primary);">CSVインポート</span>
                    <% end %>
                  </li>
                </ul>
              </li>

              <!-- 履歴・監視 -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="monitorDropdown" role="button" 
                   data-bs-toggle="dropdown" aria-expanded="false"
                   style="color: var(--text-secondary) !important; font-weight: 500; transition: var(--transition-fast);"
                   onmouseover="this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';"
                   onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';"
                   title="監視・履歴">
                  <i class="bi bi-activity me-2" style="color: var(--text-accent);"></i>
                  <span class="d-none d-lg-inline">監視</span>
                  <span class="d-lg-none">監視</span>
                </a>
                <ul class="dropdown-menu border-0 shadow" style="border-radius: var(--radius-lg); background-color: var(--bg-primary);">
                  <li>
                    <%# ✅ 完了: Phase 3 - inventory_logs機能の管理画面統合（2025年6月） %>
                    <%# CLAUDE.md準拠: 管理機能の一元化完了 %>
                    <%= link_to admin_inventory_logs_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-journal-text me-2" style="color: var(--text-accent);"></i>
                      <span style="color: var(--text-primary);">在庫履歴</span>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to admin_audit_logs_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-shield-check me-2" style="color: var(--text-success);"></i>
                      <span style="color: var(--text-primary);">監査ログ</span>
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider" style="border-color: var(--border-primary);"></li>
                  <li>
                    <%= link_to security_events_admin_audit_logs_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-shield-exclamation me-2" style="color: var(--text-danger);"></i>
                      <span style="color: var(--text-primary);">セキュリティイベント</span>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to user_activity_admin_audit_logs_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-person-lines-fill me-2" style="color: var(--text-info);"></i>
                      <span style="color: var(--text-primary);">ユーザー活動履歴</span>
                    <% end %>
                  </li>
                  <li>
                    <%= link_to compliance_report_admin_audit_logs_path, class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';" do %>
                      <i class="bi bi-file-earmark-check me-2" style="color: var(--text-success);"></i>
                      <span style="color: var(--text-primary);">コンプライアンスレポート</span>
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider" style="border-color: var(--border-primary);"></li>
                  <li>
                    <%# TODO: 🟢 Phase 4（推奨）- Sidekiq Webマウントエンジンのパス管理 %>
                    <%# 優先度: 低（機能的には問題なし） %>
                    <%# 実装内容: %>
                    <%#   - 設定ファイルでSidekiq Web UIのパスを管理 %>
                    <%#   - helper methodでの一元管理 %>
                    <%# 理由: Sidekiq::Webは外部エンジンのため、Railsパスヘルパーが自動生成されない %>
                    <%# 現状: ハードコードパスは正常動作（routes.rbでマウント確認済み） %>
                    <%= link_to "/admin/sidekiq", class: "dropdown-item d-flex align-items-center",
                        style: "color: var(--text-secondary); transition: var(--transition-fast); border-radius: var(--radius-md); margin: 0.25rem 0.5rem;",
                        onmouseover: "this.style.color='var(--text-primary)'; this.style.backgroundColor='var(--bg-secondary)';",
                        onmouseout: "this.style.color='var(--text-secondary)'; this.style.backgroundColor='transparent';",
                        target: "_blank", rel: "noopener" do %>
                      <i class="bi bi-gear me-2" style="color: var(--text-muted);"></i>
                      <span style="color: var(--text-primary);">ジョブ監視</span>
                    <% end %>
                  </li>
                </ul>
              </li>
            </ul>
            
            <!-- 右側ナビゲーション -->
            <ul class="navbar-nav">
              <!-- 通知（未実装） -->
              <li class="nav-item">
                <a class="nav-link position-relative" href="#"
                   style="color: var(--text-muted) !important;"
                   title="通知（実装予定）">
                  <i class="bi bi-bell" style="color: var(--text-muted);"></i>
                  <!-- TODO: Phase 3 - 通知機能実装時に表示 -->
                  <!-- <span class="badge position-absolute top-0 start-100 translate-middle" style="background-color: var(--text-danger);">3</span> -->
                </a>
              </li>

              <!-- ユーザーメニュー（ログアウト含む） -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" 
                   role="button" data-bs-toggle="dropdown" aria-expanded="false"
                   style="color: var(--text-secondary) !important;"
                   aria-haspopup="true" aria-label="ユーザーメニューを開く"
                   title="アカウントメニュー（ログアウトはこちら）"
                   tabindex="0">
                  <i class="bi bi-person-circle me-2 fs-5" style="color: var(--text-accent);"></i>
                  <div class="d-none d-md-block">
