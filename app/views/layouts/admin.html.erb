                  <i class="bi bi-gear me-2"></i>ジョブ監視
                <% end %>
              </div>
            </div>
          </div>
          
          <hr class="my-4">
          
          <%# ログアウトボタン %>
          <%= button_to destroy_admin_session_path, method: :delete, 
              class: "btn btn-danger w-100", 
              form: { 
                data: { 
                  turbo: false,
