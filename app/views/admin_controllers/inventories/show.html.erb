<%# 在庫詳細 - モダンUI版 %>
<% content_for :title, @inventory.name %>

<div class="container-fluid py-4 admin-inventory-detail">
  <%# ページヘッダー %>
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div class="d-flex align-items-center">
      <%= link_to admin_inventories_path, class: "btn btn-outline-secondary me-3", 
                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                  title: "在庫一覧に戻る" do %>
        <i class="bi bi-arrow-left"></i>
      <% end %>
      
      <div>
        <h1 class="h2 mb-1 d-flex align-items-center">
          <i class="bi bi-box me-2 text-primary"></i>
          <%= @inventory.name %>
        </h1>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
              <%= link_to admin_root_path, class: "text-decoration-none" do %>
                <i class="bi bi-house"></i> ダッシュボード
              <% end %>
            </li>
            <li class="breadcrumb-item">
              <%= link_to admin_inventories_path, class: "text-decoration-none" do %>
                <i class="bi bi-boxes"></i> 在庫管理
              <% end %>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
              <%= @inventory.name %>
            </li>
          </ol>
        </nav>
      </div>
    </div>
    
    <%# アクションボタン %>
    <div class="d-flex gap-2">
      <%= link_to edit_admin_inventory_path(@inventory), 
                  class: "btn btn-warning" do %>
        <i class="bi bi-pencil me-2"></i>編集
      <% end %>
      
      <%= button_to admin_inventory_path(@inventory), 
                    method: :delete,
                    form: { data: { turbo_confirm: "この在庫を削除してもよろしいですか？\n\nこの操作は取り消せません。" } },
                    class: "btn btn-danger" do %>
        <i class="bi bi-trash me-2"></i>削除
      <% end %>
    </div>
  </div>

  <%# メイン情報カード群 %>
  <div class="row g-4 mb-4">
    <%# 基本情報カード %>
    <div class="col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-gradient bg-primary text-white">
          <h5 class="mb-0">
            <i class="bi bi-info-circle me-2"></i>基本情報
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="text-secondary small">商品名</label>
            <h4 class="mb-0"><%= @inventory.name %></h4>
          </div>
          
          <div class="row g-3">
            <div class="col-6">
              <div class="text-center p-3 bg-light rounded">
                <div class="h5 mb-1 text-primary">
                  <i class="bi bi-currency-yen"></i>
                  <%= number_to_currency(@inventory.price, unit: "", precision: 0) %>
                </div>
                <small class="text-secondary">販売価格</small>
              </div>
            </div>
            <div class="col-6">
              <div class="text-center p-3 bg-light rounded">
                <div class="h5 mb-1 <%= @inventory.quantity > 10 ? 'text-success' : @inventory.quantity > 0 ? 'text-warning' : 'text-danger' %>">
                  <i class="bi bi-boxes"></i>
                  <%= number_with_delimiter(@inventory.quantity) %>
                </div>
                <small class="text-secondary">在庫数</small>
              </div>
            </div>
          </div>
          
          <hr class="my-3">
          
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary">ステータス</span>
            <span class="badge <%= @inventory.active? ? 'bg-success' : 'bg-secondary' %>">
              <%= @inventory.active? ? '販売中' : '停止中' %>
            </span>
          </div>
          
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary">在庫状態</span>
            <% if @inventory.quantity <= 0 %>
              <span class="badge bg-danger">在庫切れ</span>
            <% elsif @inventory.quantity < 10 %>
              <span class="badge bg-warning">在庫少</span>
            <% else %>
              <span class="badge bg-success">正常</span>
            <% end %>
          </div>
          
          <div class="mt-3 text-secondary small">
            <i class="bi bi-clock me-1"></i>
            最終更新: <%= l(@inventory.updated_at, format: :long) %>
          </div>
        </div>
      </div>
    </div>

    <%# ロット情報サマリー %>
    <div class="col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-gradient bg-info text-white">
          <h5 class="mb-0">
            <i class="bi bi-layers me-2"></i>ロット情報サマリー
          </h5>
        </div>
        <div class="card-body">
          <div class="text-center mb-4">
            <div class="display-4 text-info">
              <%= @inventory.batches_count %>
            </div>
            <div class="text-secondary">総ロット数</div>
          </div>
          
          <div class="row g-3">
            <div class="col-6">
              <% expired_count = @inventory.batches.select(&:expired?).count %>
              <div class="text-center p-3 rounded <%= expired_count > 0 ? 'bg-danger bg-opacity-10' : 'bg-light' %>">
                <div class="h5 mb-1 <%= expired_count > 0 ? 'text-danger' : 'text-secondary' %>">
                  <%= expired_count %>
                </div>
                <small class="text-secondary">期限切れ</small>
                <% if expired_count > 0 %>
                  <div class="mt-1">
                    <span class="badge bg-danger">要対応</span>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="col-6">
              <% expiring_soon_count = @inventory.batches.select(&:expiring_soon?).count %>
              <div class="text-center p-3 rounded <%= expiring_soon_count > 0 ? 'bg-warning bg-opacity-10' : 'bg-light' %>">
                <div class="h5 mb-1 <%= expiring_soon_count > 0 ? 'text-warning' : 'text-secondary' %>">
                  <%= expiring_soon_count %>
                </div>
                <small class="text-secondary">期限間近</small>
                <% if expiring_soon_count > 0 %>
                  <div class="mt-1">
                    <span class="badge bg-warning">確認推奨</span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          
          <% if @inventory.batches_count > 0 %>
            <div class="mt-4">
              <small class="text-secondary d-block mb-2">ロット状態分布</small>
              <div class="progress" style="height: 20px;">
                <% 
                  normal_count = @inventory.batches_count - expired_count - expiring_soon_count
                  normal_percentage = (normal_count.to_f / @inventory.batches_count * 100).round(1)
                  expiring_percentage = (expiring_soon_count.to_f / @inventory.batches_count * 100).round(1)
                  expired_percentage = (expired_count.to_f / @inventory.batches_count * 100).round(1)
                %>
                <div class="progress-bar bg-success" 
                     style="width: <%= normal_percentage %>%" 
                     data-bs-toggle="tooltip" 
                     title="正常: <%= normal_count %>件 (<%= normal_percentage %>%)">
                </div>
                <div class="progress-bar bg-warning" 
                     style="width: <%= expiring_percentage %>%"
                     data-bs-toggle="tooltip" 
                     title="期限間近: <%= expiring_soon_count %>件 (<%= expiring_percentage %>%)">
                </div>
                <div class="progress-bar bg-danger" 
                     style="width: <%= expired_percentage %>%"
                     data-bs-toggle="tooltip" 
                     title="期限切れ: <%= expired_count %>件 (<%= expired_percentage %>%)">
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# 統計・アクション %>
    <div class="col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-gradient bg-secondary text-white">
          <h5 class="mb-0">
            <i class="bi bi-graph-up me-2"></i>統計・クイックアクション
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-4">
            <h6 class="text-secondary mb-3">基本情報</h6>
            <ul class="list-unstyled mb-0">
              <li class="mb-2">
                <i class="bi bi-calendar-plus me-2 text-primary"></i>
                登録日: <%= l(@inventory.created_at, format: :short) %>
              </li>
              <li class="mb-2">
                <i class="bi bi-clock-history me-2 text-primary"></i>
                最終更新: <%= time_ago_in_words(@inventory.updated_at) %>前
              </li>
              <li class="mb-2">
                <i class="bi bi-hash me-2 text-primary"></i>
                在庫ID: #<%= @inventory.id %>
              </li>
            </ul>
          </div>
          
          <hr>
          
          <div>
            <h6 class="text-secondary mb-3">クイックアクション</h6>
            <div class="d-grid gap-2">
              <%= link_to inventory_logs_path(inventory_id: @inventory.id), 
                          class: "btn btn-outline-primary" do %>
                <i class="bi bi-journal-text me-2"></i>操作履歴を見る
              <% end %>
              
              <button class="btn btn-outline-secondary" disabled>
                <i class="bi bi-download me-2"></i>レポート出力
                <span class="badge bg-secondary ms-1">準備中</span>
              </button>
              
              <button class="btn btn-outline-secondary" disabled>
                <i class="bi bi-bell me-2"></i>アラート設定
                <span class="badge bg-secondary ms-1">準備中</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ロット一覧 %>
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
      <h5 class="mb-0">
        <i class="bi bi-layers me-2 text-primary"></i>ロット一覧
      </h5>
      <button class="btn btn-success" disabled>
        <i class="bi bi-plus-circle me-2"></i>ロット追加
        <span class="badge bg-white text-success ms-1">準備中</span>
      </button>
    </div>
    
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" style="width: 200px;">
              <i class="bi bi-upc me-1"></i>ロット番号
            </th>
            <th scope="col" style="width: 120px;">
              <i class="bi bi-boxes me-1"></i>数量
            </th>
            <th scope="col" style="width: 100px;" class="text-center">
              <i class="bi bi-percent me-1"></i>割合
            </th>
            <th scope="col">
              <i class="bi bi-calendar-event me-1"></i>有効期限
            </th>
            <th scope="col" style="width: 120px;">
              <i class="bi bi-flag me-1"></i>状態
            </th>
            <th scope="col" style="width: 100px;" class="text-end">操作</th>
          </tr>
        </thead>
        <tbody>
          <% if @inventory.batches.present? %>
            <% @inventory.batches.includes(:inventory).each do |batch| %>
              <tr class="align-middle">
                <td>
                  <code class="text-primary"><%= batch.lot_code %></code>
                </td>
                <td>
                  <span class="fw-semibold"><%= number_with_delimiter(batch.quantity) %></span>
                  <small class="text-secondary">個</small>
                </td>
                <td class="text-center">
                  <% percentage = @inventory.quantity > 0 ? (batch.quantity.to_f / @inventory.quantity * 100).round(1) : 0 %>
                  <div class="progress" style="height: 20px;">
                    <div class="progress-bar bg-info" 
                         style="width: <%= percentage %>%"
                         data-bs-toggle="tooltip"
                         title="<%= percentage %>%">
                      <%= percentage %>%
                    </div>
                  </div>
                </td>
                <td>
                  <% if batch.expires_on.present? %>
                    <i class="bi bi-calendar3 me-1 text-secondary"></i>
                    <%= l(batch.expires_on, format: :short) %>
                    <small class="text-secondary d-block">
                      (<%= distance_of_time_in_words_to_now(batch.expires_on) %>後)
                    </small>
                  <% else %>
                    <span class="text-secondary">-</span>
                  <% end %>
                </td>
                <td>
                  <% if batch.expired? %>
                    <span class="badge bg-danger">
                      <i class="bi bi-x-circle me-1"></i>期限切れ
                    </span>
                  <% elsif batch.expiring_soon? %>
                    <span class="badge bg-warning">
                      <i class="bi bi-exclamation-triangle me-1"></i>期限間近
                    </span>
                  <% else %>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>正常
                    </span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm" role="group">
                    <button class="btn btn-outline-secondary" disabled 
                            data-bs-toggle="tooltip" title="編集（準備中）">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-outline-danger" disabled
                            data-bs-toggle="tooltip" title="削除（準備中）">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-5">
                <div class="text-secondary">
                  <i class="bi bi-inbox display-1 d-block mb-3"></i>
                  <h6>ロットデータがありません</h6>
                  <p class="mb-0">ロット追加機能は準備中です</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
.admin-inventory-detail .card-header.bg-gradient.bg-primary {
  background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%) !important;
}

.admin-inventory-detail .card-header.bg-gradient.bg-info {
  background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%) !important;
}

.admin-inventory-detail .card-header.bg-gradient.bg-secondary {
  background: linear-gradient(135deg, #6c757d 0%, #545b62 100%) !important;
}

.admin-inventory-detail .card {
  transition: transform 0.2s ease-in-out;
}

.admin-inventory-detail .card:hover {
  transform: translateY(-2px);
}

.admin-inventory-detail .progress {
  background-color: #e9ecef;
}

.admin-inventory-detail .btn-group-sm .btn {
  padding: 0.25rem 0.5rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Bootstrap 5 ツールチップの初期化
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
  var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl)
  });
});
</script>