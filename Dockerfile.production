# syntax = docker/dockerfile:1

# ================================================================================
# Production-optimized Dockerfile for StockRx
# Multi-stage build for minimal image size and enhanced security
# ================================================================================

ARG RUBY_VERSION=3.3.8
ARG NODE_VERSION=20
ARG BUNDLER_VERSION=2.5.11

# ================================================================================
# Stage 1: Base dependencies
# ================================================================================
FROM ruby:${RUBY_VERSION}-slim AS base

# Install production dependencies only
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    curl \
    default-mysql-client \
    libjemalloc2 \
    libvips && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# ================================================================================
# Stage 2: Build dependencies
# ================================================================================
FROM base AS build

# Install build dependencies
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    build-essential \
    git \
    libmariadb-dev \
    libyaml-dev \
    nodejs \
    npm \
    pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Install specific bundler version
RUN gem install bundler:${BUNDLER_VERSION}

# Set production environment
ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    NODE_ENV="production"

# Create app directory
WORKDIR /app

# Copy dependency files first for better caching
COPY Gemfile Gemfile.lock ./
COPY package.json package-lock.json ./

# Install Ruby dependencies
RUN bundle config set --local frozen true && \
    bundle config set --local without 'development test' && \
    bundle install --jobs 4 --retry 3 && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git

# Install Node dependencies (if needed)
RUN if [ -f package-lock.json ]; then \
      npm ci --only=production; \
    fi

# Copy application code
COPY . .

# Precompile assets
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

# Remove unnecessary files
RUN rm -rf node_modules tmp/cache vendor/assets test spec app/assets/stylesheets/*.scss

# ================================================================================
# Stage 3: Runtime image
# ================================================================================
FROM base AS runtime

# Create non-root user
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash

# Set production environment
ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    RAILS_LOG_TO_STDOUT="1" \
    RAILS_SERVE_STATIC_FILES="true" \
    SECRET_KEY_BASE_DUMMY="1"

# Create necessary directories
WORKDIR /app
RUN mkdir -p log tmp/pids tmp/cache tmp/sockets public/assets && \
    chown -R rails:rails /app

# Copy built artifacts from build stage
COPY --from=build --chown=rails:rails /usr/local/bundle /usr/local/bundle
COPY --from=build --chown=rails:rails /app /app

# Create and set permissions for storage directories
RUN mkdir -p storage log && \
    chown -R rails:rails storage log && \
    chmod -R 755 storage log

# Switch to non-root user
USER rails:rails

# Precompile bootsnap cache for faster boot time
RUN bundle exec bootsnap precompile --gemfile app/ lib/

# Add health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Use production entrypoint
COPY --chown=rails:rails bin/docker-entrypoint-production bin/
RUN chmod +x bin/docker-entrypoint-production

ENTRYPOINT ["bin/docker-entrypoint-production"]

# Expose port
EXPOSE 3000

# Default command
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]